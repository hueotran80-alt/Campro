<%- include('../partials/admin-header') %>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
  <div class="card">
    <h3>Thông tin đơn hàng</h3>
    <p><strong>Mã đơn:</strong> #<%= order.order_code %></p>
    <p><strong>Khách hàng:</strong> <%= order.full_name %></p>
    <p><strong>Điện thoại:</strong> <%= order.phone %></p>
    <p><strong>Email:</strong> <%= order.email %></p>
    <p><strong>Địa chỉ:</strong> <%= order.address %></p>
    <p><strong>Thanh toán:</strong> <%= order.payment_method %></p>
    <p><strong>Ngày đặt:</strong> <%= new Date(order.created_at).toLocaleString('vi-VN') %></p>
    <% if (order.note) { %><p><strong>Ghi chú:</strong> <%= order.note %></p><% } %>

    <hr>
    <h4>Cập nhật trạng thái</h4>
    <form method="POST" action="/admin/orders/<%= order.id %>/status">
      <div class="form-group">
        <label>Trạng thái đơn</label>
        <select name="order_status" class="form-control">
          <option value="pending"   <%= order.order_status === 'pending'   ? 'selected' : '' %>>Chờ xử lý</option>
          <option value="confirmed" <%= order.order_status === 'confirmed' ? 'selected' : '' %>>Đã xác nhận</option>
          <option value="shipping"  <%= order.order_status === 'shipping'  ? 'selected' : '' %>>Đang giao</option>
          <option value="delivered" <%= order.order_status === 'delivered' ? 'selected' : '' %>>Đã giao</option>
          <option value="completed" <%= order.order_status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
          <option value="cancelled" <%= order.order_status === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
        </select>
      </div>
      <div class="form-group">
        <label>Trạng thái thanh toán</label>
        <select name="payment_status" class="form-control">
          <option value="pending" <%= order.payment_status === 'pending' ? 'selected' : '' %>>Chưa thanh toán</option>
          <option value="paid"    <%= order.payment_status === 'paid'    ? 'selected' : '' %>>Đã thanh toán</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Cập nhật</button>
    </form>
  </div>
  <div class="card">
    <h3>Sản phẩm trong đơn</h3>
    <% items.forEach(item => { %>
    <div class="summary-item">
      <span><%= item.product_name %> × <%= item.quantity %></span>
      <span><%= Number(item.total).toLocaleString('vi-VN') %>đ</span>
    </div>
    <% }) %>
    <hr>
    <% if (order.discount > 0) { %>
    <div class="summary-item"><span>Giảm giá</span><span style="color:green">-<%= Number(order.discount).toLocaleString('vi-VN') %>đ</span></div>
    <% } %>
    <div class="summary-item total"><strong>Tổng cộng</strong><strong><%= Number(order.total).toLocaleString('vi-VN') %>đ</strong></div>
  </div>
</div>
<a href="/admin/orders" class="btn btn-outline" style="margin-top:1rem">← Quay lại</a>
<%- include('../partials/admin-footer') %>
