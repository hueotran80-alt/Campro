<%- include('../partials/admin-header') %>
<style>
.prod-page { background:#0f1117; min-height:calc(100vh - 80px); margin:-1.5rem; padding:1.5rem; }
.prod-page h2 { color:#fff; font-size:1.5rem; font-weight:800; margin-bottom:1.25rem; }
.toolbar-dark { display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem; }
.search-form { display:flex; gap:0.5rem; }
.search-form input { background:#1a1d27; border:1px solid rgba(255,255,255,0.12); color:#fff; border-radius:8px; padding:0.5rem 0.9rem; font-size:0.88rem; outline:none; min-width:220px; }
.search-form input::placeholder { color:#666; }
.search-form input:focus { border-color:#4e9af1; }
.btn-search { background:#4e9af1; color:#fff; border:none; border-radius:8px; padding:0.5rem 1.1rem; cursor:pointer; font-size:0.88rem; font-weight:600; }
.btn-add { background:#4e9af1; color:#fff; border:none; border-radius:8px; padding:0.5rem 1.2rem; font-size:0.88rem; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:0.4rem; }
.btn-delete-sel { background:#e53e3e; color:#fff; border:none; border-radius:8px; padding:0.5rem 1.2rem; font-size:0.88rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem; }
.btn-delete-sel:disabled { opacity:0.4; cursor:not-allowed; }
.prod-table-card { background:#1a1d27; border-radius:12px; border:1px solid rgba(255,255,255,0.08); overflow:hidden; }
.prod-table-header { display:flex; justify-content:space-between; align-items:center; padding:1rem 1.5rem; border-bottom:1px solid rgba(255,255,255,0.08); }
.prod-table-header span { color:#ccc; font-size:0.9rem; font-weight:600; }
.prod-table-header .page-info { color:#888; font-size:0.82rem; }
.p-table { width:100%; border-collapse:collapse; }
.p-table th { color:#888; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.07em; padding:0.7rem 1rem; border-bottom:1px solid rgba(255,255,255,0.07); font-weight:600; background:#151821; text-align:left; }
.p-table td { color:#ccc; font-size:0.85rem; padding:0.7rem 1rem; border-bottom:1px solid rgba(255,255,255,0.05); vertical-align:middle; }
.p-table tbody tr:hover { background:rgba(255,255,255,0.03); }
.p-table input[type=checkbox] { width:16px; height:16px; accent-color:#4e9af1; cursor:pointer; }
.prod-img { width:48px; height:48px; object-fit:cover; border-radius:6px; border:1px solid rgba(255,255,255,0.1); }
.cat-badge { display:inline-block; padding:0.2rem 0.6rem; border-radius:20px; font-size:0.72rem; font-weight:700; background:rgba(78,154,241,0.15); color:#4e9af1; }
.price-text { color:#34d399; font-weight:700; }
.stock-num { color:#a78bfa; font-weight:700; }
.btn-edit { background:#4e9af1; color:#fff; border:none; border-radius:6px; padding:0.25rem 0.7rem; font-size:0.78rem; font-weight:600; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem; }
.btn-del { background:#e53e3e; color:#fff; border:none; border-radius:6px; padding:0.25rem 0.7rem; font-size:0.78rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:0.3rem; }
.pag-row { padding:1rem 1.5rem; display:flex; justify-content:flex-end; gap:0.35rem; flex-wrap:wrap; }
.pag-btn { display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:6px; background:#252836; color:#aaa; font-size:0.82rem; text-decoration:none; }
.pag-btn.active, .pag-btn:hover { background:#4e9af1; color:#fff; }
</style>

<div class="prod-page">
  <h2>Quản lý Sản Phẩm</h2>

  <form id="bulk-form" method="POST" action="/admin/products/bulk-delete" onsubmit="return confirmBulk()">
  <div class="toolbar-dark">
    <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap">
      <div class="search-form">
        <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Tìm sản phẩm..." id="searchInput">
        <button type="button" class="btn-search" onclick="doSearch()"><i class="fas fa-search"></i> Tìm</button>
      </div>
      <button type="submit" class="btn-delete-sel" id="btnDeleteSel" disabled>
        <i class="fas fa-trash"></i> Xóa đã chọn (<span id="selCount">0</span>)
      </button>
    </div>
    <a href="/admin/products/create" class="btn-add"><i class="fas fa-plus"></i> Thêm sản phẩm</a>
  </div>

  <div class="prod-table-card">
    <div class="prod-table-header">
      <span>Danh sách sản phẩm (Trang <%= pagination.page %>/<%= pagination.totalPages || 1 %>)</span>
      <button type="submit" class="btn-delete-sel" id="btnDeleteSel2" disabled style="padding:0.35rem 0.9rem;font-size:0.8rem">
        <i class="fas fa-trash"></i> Xóa đã chọn
      </button>
    </div>
    <table class="p-table">
      <thead>
        <tr>
          <th><input type="checkbox" id="chkAll" onclick="toggleAll(this)"></th>
          <th>ID</th>
          <th>Ảnh</th>
          <th>Tên Sản phẩm</th>
          <th>Loại</th>
          <th>Giá</th>
          <th>Tồn kho</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
        <tr>
          <td><input type="checkbox" name="ids[]" value="<%= p.id %>" class="row-chk" onchange="updateSel()"></td>
          <td style="color:#666"><%= p.id %></td>
          <td><img class="prod-img" src="<%= p.image ? '/uploads/' + p.image : '/images/no-image.svg' %>" alt=""></td>
          <td><%= p.name %></td>
          <td><span class="cat-badge"><%= p.category_name || 'N/A' %></span></td>
          <td class="price-text"><%= Number(p.sale_price || p.price).toLocaleString('vi-VN') %> VND</td>
          <td class="stock-num"><%= p.stock %></td>
          <td>
            <a href="/admin/products/<%= p.id %>/edit" class="btn-edit"><i class="fas fa-pen"></i> Sửa</a>
            <button type="button" class="btn-del" onclick="deleteSingle(<%= p.id %>)"><i class="fas fa-trash"></i> Xóa</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (pagination.totalPages > 1) { %>
    <div class="pag-row">
      <% for (let i = 1; i <= pagination.totalPages; i++) { %>
        <a href="?page=<%= i %><%= query.search ? '&search=' + query.search : '' %>" class="pag-btn <%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
    <% } %>
  </div>
  </form>

  <!-- Hidden single delete form -->
  <form id="single-del-form" method="POST" style="display:none">
    <input type="hidden" name="_method" value="DELETE">
  </form>
</div>

<script>
function toggleAll(src) {
  document.querySelectorAll('.row-chk').forEach(c => c.checked = src.checked);
  updateSel();
}
function updateSel() {
  const n = document.querySelectorAll('.row-chk:checked').length;
  document.getElementById('selCount').textContent = n;
  document.getElementById('btnDeleteSel').disabled = n === 0;
  document.getElementById('btnDeleteSel2').disabled = n === 0;
  const all = document.querySelectorAll('.row-chk');
  document.getElementById('chkAll').checked = n === all.length && all.length > 0;
  document.getElementById('chkAll').indeterminate = n > 0 && n < all.length;
}
function confirmBulk() {
  const n = document.querySelectorAll('.row-chk:checked').length;
  if (n === 0) return false;
  return confirm('Xóa ' + n + ' sản phẩm đã chọn?');
}
function deleteSingle(id) {
  if (!confirm('Xóa sản phẩm này?')) return;
  const f = document.getElementById('single-del-form');
  f.action = '/admin/products/' + id + '/delete';
  f.submit();
}
function doSearch() {
  const q = document.getElementById('searchInput').value;
  window.location.href = '/admin/products' + (q ? '?search=' + encodeURIComponent(q) : '');
}
</script>

<%- include('../partials/admin-footer') %>
