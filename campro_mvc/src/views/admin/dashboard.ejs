<%- include('../partials/admin-header') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.min.css">
<style>
.dashboard-dark { background: #0f1117; min-height: calc(100vh - 80px); margin: -1.5rem; padding: 1.5rem; }
.dash-title { font-size: 2rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; }
.dash-title i { color: #4e9af1; }
.stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-bottom: 1.75rem; }
.dash-stat {
  background: #1a1d27; border-radius: 12px; padding: 1.4rem 1.5rem;
  border: 1px solid rgba(255,255,255,0.08); position: relative; overflow: hidden;
}
.dash-stat .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; color: #888; text-transform: uppercase; margin-bottom: 0.6rem; }
.dash-stat .value { font-size: 1.8rem; font-weight: 800; color: #fff; }
.dash-stat .icon { position: absolute; right: 1.2rem; top: 50%; transform: translateY(-50%); font-size: 2.2rem; opacity: 0.18; }
.dash-stat.revenue { border-left: 3px solid #4e9af1; }
.dash-stat.orders  { border-left: 3px solid #a78bfa; }
.dash-stat.customers { border-left: 3px solid #34d399; }
.dash-stat.products { border-left: 3px solid #f87171; }
.dash-stat .revenue-ok { background: #059669; color: #fff; border-radius: 50%; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.9rem; margin-left: 8px; vertical-align: middle; }

.charts-row { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1.5rem; }
.chart-card { background: #1a1d27; border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,0.08); }
.chart-card h3 { color: #fff; font-size: 1rem; font-weight: 700; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
.chart-card h3 i { color: #4e9af1; }
.chart-card h3.trophy i { color: #f59e0b; }
canvas { width: 100% !important; }
.recent-orders { margin-top: 1.5rem; background: #1a1d27; border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,0.08); }
.recent-orders h3 { color: #fff; font-size: 1rem; font-weight: 700; margin-bottom: 1rem; }
.recent-orders table { width: 100%; border-collapse: collapse; }
.recent-orders th { color: #888; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; padding: 0.5rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.07); text-align: left; }
.recent-orders td { color: #ccc; font-size: 0.85rem; padding: 0.65rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.05); }
.recent-orders td a { color: #4e9af1; }
.status-badge { display: inline-block; padding: 0.18rem 0.55rem; border-radius: 20px; font-size: 0.7rem; font-weight: 700; }
.st-pending    { background: rgba(245,158,11,0.2); color: #f59e0b; }
.st-completed  { background: rgba(52,211,153,0.2); color: #34d399; }
.st-cancelled  { background: rgba(248,113,113,0.2); color: #f87171; }
.st-processing { background: rgba(96,165,250,0.2); color: #60a5fa; }
.st-shipping   { background: rgba(167,139,250,0.2); color: #a78bfa; }
</style>

<div class="dashboard-dark">
  <div class="dash-title"><i class="fas fa-tachometer-alt"></i> Dashboard</div>

  <!-- Stats -->
  <div class="stats-row">
    <div class="dash-stat revenue">
      <div class="label">Tổng doanh thu (Hoàn thành)</div>
      <div class="value">
        <%= Number(stats.total_revenue).toLocaleString('vi-VN') %>đ
        <span class="revenue-ok"><i class="fas fa-check"></i></span>
      </div>
      <i class="fas fa-money-bill-wave icon" style="color:#4e9af1"></i>
    </div>
    <div class="dash-stat orders">
      <div class="label">Tổng số đơn hàng</div>
      <div class="value"><%= stats.total_orders %></div>
      <i class="fas fa-clipboard-list icon" style="color:#a78bfa"></i>
    </div>
    <div class="dash-stat customers">
      <div class="label">Tổng khách hàng</div>
      <div class="value"><%= stats.total_customers %></div>
      <i class="fas fa-users icon" style="color:#34d399"></i>
    </div>
    <div class="dash-stat products">
      <div class="label">Tổng sản phẩm</div>
      <div class="value"><%= stats.total_products %></div>
      <i class="fas fa-box icon" style="color:#f87171"></i>
    </div>
  </div>

  <!-- Charts -->
  <div class="charts-row">
    <div class="chart-card">
      <h3><i class="fas fa-chart-bar"></i> Doanh thu (7 ngày qua)</h3>
      <canvas id="revenueChart" height="220"></canvas>
    </div>
    <div class="chart-card">
      <h3 class="trophy"><i class="fas fa-trophy"></i> Top 5 Sản phẩm Bán Chạy</h3>
      <canvas id="topChart" height="220"></canvas>
    </div>
  </div>

  <!-- Recent Orders -->
  <div class="recent-orders">
    <h3>Đơn hàng gần đây</h3>
    <table>
      <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
      <tbody>
        <% recentOrders.forEach(o => { %>
        <tr>
          <td><a href="/admin/orders/<%= o.id %>">#<%= o.order_code %></a></td>
          <td><%= o.full_name || 'Khách lẻ' %></td>
          <td style="color:#4e9af1;font-weight:600"><%= Number(o.total).toLocaleString('vi-VN') %>đ</td>
          <td>
            <span class="status-badge st-<%= o.order_status %>">
              <%= o.order_status === 'pending' ? 'Chờ xử lý' : o.order_status === 'completed' ? 'Hoàn thành' : o.order_status === 'cancelled' ? 'Đã hủy' : o.order_status === 'processing' ? 'Đang xử lý' : 'Đang giao' %>
            </span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
// Revenue Chart (7 days)
const revLabels = <%- JSON.stringify(revenueChart.map(r => r.day)) %>;
const revData   = <%- JSON.stringify(revenueChart.map(r => Number(r.revenue))) %>;

new Chart(document.getElementById('revenueChart'), {
  type: 'bar',
  data: {
    labels: revLabels,
    datasets: [{
      label: 'Doanh thu (VND)',
      data: revData,
      backgroundColor: 'rgba(78,154,241,0.75)',
      borderColor: '#4e9af1',
      borderWidth: 2,
      borderRadius: 4
    }]
  },
  options: {
    responsive: true, plugins: { legend: { display: false } },
    scales: {
      x: { ticks: { color: '#888', font: { size: 11 } }, grid: { color: 'rgba(255,255,255,0.05)' } },
      y: { ticks: { color: '#888', font: { size: 10 }, callback: v => (v >= 1e6 ? (v/1e6).toFixed(0)+'M' : v) }, grid: { color: 'rgba(255,255,255,0.05)' } }
    }
  }
});

// Top Products Doughnut
const topLabels = <%- JSON.stringify(topProducts.map(p => p.name)) %>;
const topData   = <%- JSON.stringify(topProducts.map(p => p.sold)) %>;
const colors = ['#4e9af1','#34d399','#a78bfa','#06b6d4','#9ca3af'];

new Chart(document.getElementById('topChart'), {
  type: 'doughnut',
  data: {
    labels: topLabels,
    datasets: [{ data: topData, backgroundColor: colors, borderWidth: 2, borderColor: '#1a1d27' }]
  },
  options: {
    responsive: true, cutout: '60%',
    plugins: {
      legend: { position: 'bottom', labels: { color: '#aaa', font: { size: 11 }, padding: 10, boxWidth: 12 } }
    }
  }
});
</script>

<%- include('../partials/admin-footer') %>
