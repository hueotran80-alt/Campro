<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CAMPRO Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<div class="admin-layout">
  <!-- SIDEBAR -->
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon"><i class="fas fa-mobile-alt"></i></div>
      <div>
        <div class="brand-name">PHONE SHOP</div>
        <div class="brand-sub">Admin Dashboard</div>
      </div>
    </div>
    <nav class="admin-nav">
      <div class="nav-section-label">TỔNG QUAN</div>
      <a href="/" class="nav-item"><i class="fas fa-globe"></i> <span>Xem Trang chủ</span></a>
      <a href="/admin/dashboard" class="nav-item"><i class="fas fa-tachometer-alt"></i> <span>Dashboard</span></a>

      <div class="nav-section-label">QUẢN LÝ SẢN PHẨM</div>
      <a href="/admin/categories" class="nav-item"><i class="fas fa-list"></i> <span>Danh mục Loại Camera</span></a>
      <a href="/admin/products" class="nav-item"><i class="fas fa-mobile-alt"></i> <span>Quản lý Sản Phẩm</span></a>

      <div class="nav-section-label">BÁN HÀNG</div>
      <a href="/admin/orders" class="nav-item"><i class="fas fa-receipt"></i> <span>Quản lý Đơn hàng</span></a>
      <a href="/admin/customers" class="nav-item"><i class="fas fa-users"></i> <span>Quản lý Khách hàng</span></a>

      <div class="nav-section-label">THỐNG KÊ &amp; BÁO CÁO</div>
      <a href="/admin/report" class="nav-item"><i class="fas fa-chart-line"></i> <span>Báo cáo Doanh thu</span></a>

      <div class="nav-section-label">HỆ THỐNG</div>
      <a href="/admin/suppliers" class="nav-item"><i class="fas fa-truck"></i> <span>Nhà cung cấp</span></a>
      <a href="/admin/coupons" class="nav-item"><i class="fas fa-ticket-alt"></i> <span>Mã giảm giá</span></a>
      <a href="/admin/news" class="nav-item"><i class="fas fa-newspaper"></i> <span>Tin tức</span></a>
      <a href="/admin/contacts" class="nav-item"><i class="fas fa-envelope"></i> <span>Liên hệ</span></a>
      <a href="/auth/logout" class="nav-item nav-logout"><i class="fas fa-sign-out-alt"></i> <span>Đăng xuất</span></a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="topbar-left">
        <i class="fas fa-shield-alt" style="color:#4e9af1;font-size:1.2rem"></i>
        <div>
          <div style="font-size:1rem;font-weight:700;color:#fff">CAMPRO Admin Panel</div>
          <div style="font-size:0.75rem;color:#888">Quản lý hệ thống cửa hàng Camera</div>
        </div>
      </div>
      <div class="topbar-right">
        <span style="color:#aaa;font-size:0.82rem">Xin chào,</span>
        <span style="color:#fff;font-weight:700;font-size:0.9rem"><%= user ? user.full_name : 'Admin' %></span>
        <div class="avatar-circle"><%= user ? user.full_name.charAt(0).toUpperCase() : 'A' %></div>
      </div>
    </div>

    <div class="admin-content">
      <!-- FLASH -->
      <% if (success && success.length) { %><div class="flash flash-success"><i class="fas fa-check-circle"></i> <%= success[0] %></div><% } %>
      <% if (error && error.length) { %><div class="flash flash-error"><i class="fas fa-exclamation-circle"></i> <%= error[0] %></div><% } %>
