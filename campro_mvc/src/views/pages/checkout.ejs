<%- include('../partials/header') %>

<div class="container checkout-container">
  <h1 class="checkout-title">💳 Thanh toán</h1>

  <div class="checkout-layout">
    <!-- LEFT: FORM THÔNG TIN -->
    <form method="POST" action="/orders/checkout" id="checkoutForm">
      <!-- THÔNG TIN GIAO HÀNG -->
      <div class="card checkout-card">
        <h3><i class="fas fa-map-marker-alt"></i> Thông tin giao hàng</h3>
        <div class="form-row-2">
          <div class="form-group">
            <label>Họ tên <span style="color:#e74c3c">*</span></label>
            <input type="text" name="full_name" class="form-control"
                   value="<%= user.full_name %>" required placeholder="Nguyễn Văn A">
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control"
                   value="<%= user.email %>">
          </div>
        </div>
        <div class="form-group">
          <label>Số điện thoại <span style="color:#e74c3c">*</span></label>
          <input type="tel" name="phone" class="form-control"
                 value="<%= user.phone || '' %>" required placeholder="0912 345 678">
        </div>
        <div class="form-group">
          <label>Địa chỉ giao hàng <span style="color:#e74c3c">*</span></label>
          <input type="text" name="address" class="form-control"
                 value="<%= user.address || '' %>" required
                 placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành">
        </div>
        <div class="form-group">
          <label>Ghi chú</label>
          <textarea name="note" class="form-control" rows="3"
                    placeholder="Ghi chú đơn hàng..."></textarea>
        </div>
      </div>

      <!-- PHƯƠNG THỨC THANH TOÁN -->
      <div class="card checkout-card">
        <h3><i class="fas fa-credit-card"></i> Phương thức thanh toán</h3>
        <div class="payment-options">
          <label class="payment-option">
            <input type="radio" name="payment_method" value="cod" checked>
            <div class="pay-opt-inner">
              <i class="fas fa-money-bill-wave" style="color:#27ae60;font-size:1.4rem"></i>
              <div>
                <strong>Thanh toán khi nhận hàng (COD)</strong>
                <small>Kiểm tra hàng trước khi thanh toán</small>
              </div>
            </div>
          </label>
          <label class="payment-option">
            <input type="radio" name="payment_method" value="bank_transfer">
            <div class="pay-opt-inner">
              <i class="fas fa-university" style="color:#3498db;font-size:1.4rem"></i>
              <div>
                <strong>Chuyển khoản ngân hàng</strong>
                <small>Nhận thông tin tài khoản qua email</small>
              </div>
            </div>
          </label>
        </div>
      </div>

      <!-- MÃ GIẢM GIÁ -->
      <div class="card checkout-card">
        <h3><i class="fas fa-tags"></i> Mã giảm giá</h3>
        <div class="coupon-row">
          <input type="text" id="couponInput" class="form-control"
                 placeholder="Nhập mã giảm giá (VD: CAMPRO10)"
                 style="text-transform:uppercase;letter-spacing:1px;font-weight:600">
          <button type="button" id="couponBtn" onclick="applyCoupon()"
                  style="background:var(--primary);color:#fff;border:none;padding:.55rem 1.1rem;
                         border-radius:6px;font-weight:600;cursor:pointer;white-space:nowrap;
                         display:flex;align-items:center;gap:.4rem;transition:all .2s">
            <i class="fas fa-check-circle"></i> Áp dụng
          </button>
        </div>
        <div id="couponMsg" style="display:none;margin-top:.75rem;padding:.6rem .9rem;
             border-radius:6px;font-size:.88rem;font-weight:500"></div>

        <!-- Hidden values submit cùng form -->
        <input type="hidden" name="coupon_code" id="couponCodeHidden">
      </div>

      <button type="submit" class="btn-checkout-submit">
        <i class="fas fa-check-circle"></i> Đặt hàng ngay
      </button>
    </form>

    <!-- RIGHT: TÓM TẮT ĐƠN HÀNG -->
    <div class="order-summary-box">
      <div class="card order-summary-card">
        <h3><i class="fas fa-shopping-bag"></i> Đơn hàng</h3>

        <div class="order-items-list">
          <% items.forEach(item => { %>
          <div class="oi-row">
            <div class="oi-img-wrap">
              <img src="<%= item.image ? '/uploads/' + item.image : '/images/no-image.svg' %>"
                   alt="<%= item.name %>">
              <span class="oi-qty"><%= item.quantity %></span>
            </div>
            <div class="oi-info">
              <p class="oi-name"><%= item.name %></p>
              <p class="oi-unit"><%= Number(item.sale_price || item.price).toLocaleString('vi-VN') %>đ / cái</p>
            </div>
            <div class="oi-total">
              <%= Number((item.sale_price || item.price) * item.quantity).toLocaleString('vi-VN') %>đ
            </div>
          </div>
          <% }) %>
        </div>

        <div class="summary-totals">
          <div class="st-row">
            <span>Tạm tính</span>
            <span id="subtotalDisplay"><%= Number(subtotal).toLocaleString('vi-VN') %>đ</span>
          </div>
          <div class="st-row discount-row" id="discountRow" style="display:none">
            <span style="color:#27ae60"><i class="fas fa-tag"></i> Giảm giá</span>
            <span id="discountDisplay" style="color:#27ae60;font-weight:700">-0đ</span>
          </div>
          <div class="st-row">
            <span>Phí vận chuyển</span>
            <span style="color:#27ae60;font-weight:600"><i class="fas fa-truck"></i> Miễn phí</span>
          </div>
          <hr style="margin:.75rem 0;border-color:#e0e0e0">
          <div class="st-row grand-total-row">
            <strong>Tổng cộng</strong>
            <strong id="grandTotal" style="color:var(--primary);font-size:1.2rem">
              <%= Number(subtotal).toLocaleString('vi-VN') %>đ
            </strong>
          </div>
        </div>

        <div class="trust-bar">
          <div><i class="fas fa-shield-alt"></i> Bảo mật SSL</div>
          <div><i class="fas fa-undo"></i> Đổi trả 7 ngày</div>
          <div><i class="fas fa-headset"></i> Hỗ trợ 24/7</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.checkout-container { padding:2rem 0 4rem }
.checkout-title { font-size:1.6rem;margin-bottom:1.5rem;color:var(--dark) }
.checkout-layout { display:grid;grid-template-columns:1fr 370px;gap:1.5rem;align-items:start }

.checkout-card { margin-bottom:1rem }
.checkout-card h3 { font-size:1rem;font-weight:700;color:var(--dark);margin-bottom:1.25rem;
  border-bottom:1px solid var(--border);padding-bottom:.75rem;display:flex;align-items:center;gap:.5rem }

.form-row-2 { display:grid;grid-template-columns:1fr 1fr;gap:1rem }

/* Payment options */
.payment-options { display:flex;flex-direction:column;gap:.75rem }
.payment-option { cursor:pointer }
.payment-option input[type="radio"] { display:none }
.pay-opt-inner { display:flex;align-items:center;gap:1rem;padding:.9rem 1rem;
  border:2px solid var(--border);border-radius:8px;transition:all .2s }
.payment-option input:checked + .pay-opt-inner { border-color:var(--primary);background:rgba(108,99,255,.06) }
.pay-opt-inner strong { display:block;font-size:.9rem }
.pay-opt-inner small { color:var(--text-muted);font-size:.8rem }

/* Coupon row */
.coupon-row { display:flex;gap:.5rem }
.coupon-row .form-control { flex:1 }

/* Submit */
.btn-checkout-submit { width:100%;padding:1rem;background:var(--primary);color:#fff;
  border:none;border-radius:8px;font-size:1.05rem;font-weight:700;cursor:pointer;
  transition:all .2s;display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:.5rem }
.btn-checkout-submit:hover { background:var(--primary-dark);transform:translateY(-1px);
  box-shadow:0 4px 15px rgba(108,99,255,.4) }

/* Order summary */
.order-summary-card { position:sticky;top:80px }
.order-summary-card h3 { font-size:1rem;font-weight:700;margin-bottom:1rem;
  border-bottom:1px solid var(--border);padding-bottom:.75rem;display:flex;align-items:center;gap:.5rem }
.order-items-list { max-height:280px;overflow-y:auto;margin-bottom:1rem }

.oi-row { display:flex;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid #f5f5f5 }
.oi-img-wrap { position:relative;flex-shrink:0 }
.oi-img-wrap img { width:54px;height:54px;object-fit:cover;border-radius:6px;border:1px solid var(--border) }
.oi-qty { position:absolute;top:-6px;right:-6px;background:var(--primary);color:#fff;
  font-size:.7rem;font-weight:700;width:18px;height:18px;border-radius:50%;
  display:flex;align-items:center;justify-content:center }
.oi-info { flex:1;min-width:0 }
.oi-name { font-size:.85rem;font-weight:600;color:var(--dark);overflow:hidden;text-overflow:ellipsis;white-space:nowrap }
.oi-unit { font-size:.78rem;color:var(--text-muted);margin-top:2px }
.oi-total { font-size:.9rem;font-weight:700;color:var(--dark);white-space:nowrap }

.summary-totals { font-size:.9rem }
.st-row { display:flex;justify-content:space-between;padding:.45rem 0;color:var(--text-muted) }
.grand-total-row { color:var(--dark) }

.trust-bar { display:flex;justify-content:space-between;margin-top:1rem;
  padding-top:1rem;border-top:1px solid var(--border) }
.trust-bar div { display:flex;align-items:center;gap:.3rem;font-size:.75rem;color:var(--text-muted) }
.trust-bar i { color:var(--primary) }

@media(max-width:900px){
  .checkout-layout { grid-template-columns:1fr }
  .order-summary-card { position:static }
  .form-row-2 { grid-template-columns:1fr }
}
</style>

<script>
const SUBTOTAL = <%= subtotal %>;
let currentDiscount = 0;
let couponApplied = false;

function fmtVND(n){ return new Intl.NumberFormat('vi-VN').format(Math.round(n))+'đ' }

function updateTotal(){
  const grand = Math.max(0, SUBTOTAL - currentDiscount);
  document.getElementById('grandTotal').textContent = fmtVND(grand);
  document.getElementById('discountDisplay').textContent = '-' + fmtVND(currentDiscount);
  document.getElementById('discountRow').style.display = currentDiscount > 0 ? 'flex' : 'none';
}

function showMsg(type, text){
  const el = document.getElementById('couponMsg');
  const colors = { success:['#d4edda','#155724','#28a745'], error:['#f8d7da','#721c24','#dc3545'], loading:['#fff3cd','#856404','#ffc107'] };
  const [bg,fg,bd] = colors[type];
  el.style.cssText = `display:block;background:${bg};color:${fg};border-left:3px solid ${bd}`;
  el.textContent = text;
}

async function applyCoupon(){
  const input = document.getElementById('couponInput');
  const btn   = document.getElementById('couponBtn');
  const code  = input.value.trim().toUpperCase();

  // Nếu đang ở trạng thái "Bỏ mã"
  if(couponApplied){
    currentDiscount = 0;
    couponApplied = false;
    document.getElementById('couponCodeHidden').value = '';
    input.value = '';
    input.readOnly = false;
    btn.innerHTML = '<i class="fas fa-check-circle"></i> Áp dụng';
    btn.style.background = 'var(--primary)';
    document.getElementById('couponMsg').style.display = 'none';
    updateTotal();
    return;
  }

  if(!code){ showMsg('error','⚠️ Vui lòng nhập mã giảm giá.'); return; }

  showMsg('loading','⏳ Đang kiểm tra mã...');
  btn.disabled = true;

  try{
    const res  = await fetch('/orders/coupon-check', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ coupon_code: code, subtotal: SUBTOTAL })
    });
    const data = await res.json();

    if(data.ok){
      currentDiscount = data.discount;
      couponApplied = true;
      document.getElementById('couponCodeHidden').value = code;
      input.readOnly = true;
      btn.innerHTML = '<i class="fas fa-times-circle"></i> Bỏ mã';
      btn.style.background = '#27ae60';
      showMsg('success', data.message);
      updateTotal();
    } else {
      currentDiscount = 0;
      document.getElementById('couponCodeHidden').value = '';
      showMsg('error','❌ ' + data.message);
      updateTotal();
    }
  } catch(e){
    showMsg('error','❌ Lỗi kết nối. Vui lòng thử lại.');
  } finally {
    btn.disabled = false;
  }
}

document.getElementById('couponInput').addEventListener('keydown', e => {
  if(e.key==='Enter'){ e.preventDefault(); applyCoupon(); }
});
document.getElementById('couponInput').addEventListener('input', function(){
  this.value = this.value.toUpperCase();
});
</script>

<%- include('../partials/footer') %>
