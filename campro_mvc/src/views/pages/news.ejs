<%- include('../partials/header') %>
<div class="container" style="padding:2rem 0">
  <h1>📰 Tin tức</h1>
  <div class="news-grid">
    <% news.forEach(n => { %>
    <div class="news-card">
      <a href="/news/<%= n.slug %>">
        <% if (n.thumbnail) { %><img src="/uploads/<%= n.thumbnail %>" alt="<%= n.title %>"><% } %>
        <div class="news-info">
          <h3><%= n.title %></h3>
          <p><%= n.excerpt || '' %></p>
          <small><%= n.author_name %> • <%= new Date(n.created_at).toLocaleDateString('vi-VN') %></small>
        </div>
      </a>
    </div>
    <% }) %>
  </div>
  <% if (pagination.totalPages > 1) { %>
  <div class="pagination">
    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
      <a href="?page=<%= i %>" class="page-btn <%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
    <% } %>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
