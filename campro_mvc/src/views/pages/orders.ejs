<%- include('../partials/header') %>
<div class="container" style="padding:2rem 0">
  <h1>📦 Đơn hàng của tôi</h1>
  <% if (orders.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <p>Chưa có đơn hàng nào</p>
      <a href="/products" class="btn btn-primary">Mua sắm ngay</a>
    </div>
  <% } else { %>
  <div class="orders-table-wrap">
    <table class="table">
      <thead>
        <tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
        <tr>
          <td><strong>#<%= o.order_code %></strong></td>
          <td><%= new Date(o.created_at).toLocaleDateString('vi-VN') %></td>
          <td><%= Number(o.total).toLocaleString('vi-VN') %>đ</td>
          <td>
            <span class="badge badge-<%= o.order_status === 'pending' ? 'warning' : o.order_status === 'delivered' ? 'success' : o.order_status === 'cancelled' ? 'danger' : 'info' %>">
              <%= o.order_status %>
            </span>
          </td>
          <td><a href="/orders/<%= o.id %>" class="btn btn-outline btn-sm">Chi tiết</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
