<%- include('../partials/header') %>
<div class="container" style="padding:2rem 0">
  <h1>🛒 Giỏ hàng</h1>
  <% if (items.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-shopping-cart"></i>
      <p>Giỏ hàng trống</p>
      <a href="/products" class="btn btn-primary">Tiếp tục mua sắm</a>
    </div>
  <% } else { %>
  <div class="cart-layout">
    <div class="cart-items">
      <% items.forEach(item => { %>
      <div class="cart-item">
        <img src="<%= item.image ? '/uploads/' + item.image : '/images/no-image.jpg' %>" alt="<%= item.name %>">
        <div class="cart-item-info">
          <h3><%= item.name %></h3>
          <p class="price"><%= Number(item.sale_price || item.price).toLocaleString('vi-VN') %>đ</p>
        </div>
        <form action="/cart/update/<%= item.id %>" method="POST" class="qty-form">
          <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.stock %>" class="form-control qty-input" onchange="this.form.submit()">
        </form>
        <p class="item-total"><%= Number((item.sale_price || item.price) * item.quantity).toLocaleString('vi-VN') %>đ</p>
        <form action="/cart/remove/<%= item.id %>" method="POST">
          <button type="submit" class="btn-icon btn-danger"><i class="fas fa-trash"></i></button>
        </form>
      </div>
      <% }) %>
    </div>
    <div class="cart-summary">
      <h3>Tổng cộng</h3>
      <div class="total-price"><%= Number(total).toLocaleString('vi-VN') %>đ</div>
      <a href="/orders/checkout" class="btn btn-primary btn-full btn-lg">Tiến hành thanh toán</a>
      <form action="/cart/clear" method="POST" style="margin-top:1rem">
        <button type="submit" class="btn btn-outline btn-full" onclick="return confirm('Xóa tất cả?')">Xóa giỏ hàng</button>
      </form>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
