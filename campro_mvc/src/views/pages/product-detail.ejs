<%- include('../partials/header') %>

<div class="container" style="padding:2rem 0">
  <div class="product-detail-layout">
    <!-- IMAGE -->
    <div class="product-detail-image">
      <img src="<%= product.image ? '/uploads/' + product.image : '/images/no-image.jpg' %>" alt="<%= product.name %>">
    </div>

    <!-- INFO -->
    <div class="product-detail-info">
      <p class="breadcrumb"><a href="/products">Sản phẩm</a> / <%= product.category_name || '' %></p>
      <h1><%= product.name %></h1>

      <div class="price-box">
        <% if (product.sale_price) { %>
          <span class="sale-price big"><%= Number(product.sale_price).toLocaleString('vi-VN') %>đ</span>
          <span class="original-price"><%= Number(product.price).toLocaleString('vi-VN') %>đ</span>
        <% } else { %>
          <span class="sale-price big"><%= Number(product.price).toLocaleString('vi-VN') %>đ</span>
        <% } %>
      </div>

      <div class="product-specs">
        <% if (product.stock > 0) { %>
          <span class="badge badge-success">Còn hàng (<%= product.stock %>)</span>
        <% } else { %>
          <span class="badge badge-danger">Hết hàng</span>
        <% } %>
        <% if (product.resolution) { %><span class="badge badge-info">Độ phân giải: <%= product.resolution %></span><% } %>
        <% if (product.view_angle) { %><span class="badge badge-info">Góc nhìn: <%= product.view_angle %>°</span><% } %>
        <% if (product.supplier_name) { %><span class="badge badge-secondary">Hãng: <%= product.supplier_name %></span><% } %>
      </div>

      <% if (user && product.stock > 0) { %>
      <form action="/cart/add" method="POST" class="add-to-cart-form" style="margin-top:1rem">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <div class="quantity-control">
          <label>Số lượng:</label>
          <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" class="form-control" style="width:80px">
        </div>
        <button type="submit" class="btn btn-primary btn-lg">
          <i class="fas fa-cart-plus"></i> Thêm vào giỏ hàng
        </button>
      </form>
      <% } else if (!user) { %>
      <a href="/auth/login" class="btn btn-primary btn-lg" style="margin-top:1rem">Đăng nhập để mua hàng</a>
      <% } %>

      <% if (product.description) { %>
      <div class="product-description">
        <h3>Mô tả sản phẩm</h3>
        <p><%- product.description %></p>
      </div>
      <% } %>

      <% if (product.specifications) { %>
      <div class="product-description">
        <h3>Thông số kỹ thuật</h3>
        <pre><%= product.specifications %></pre>
      </div>
      <% } %>
    </div>
  </div>

  <!-- RELATED PRODUCTS -->
  <% if (related.length) { %>
  <section style="margin-top:3rem">
    <h2 class="section-title">Sản phẩm liên quan</h2>
    <div class="product-grid">
      <% related.forEach(p => { %>
      <div class="product-card">
        <a href="/products/<%= p.slug %>">
          <img src="<%= p.image ? '/uploads/' + p.image : '/images/no-image.jpg' %>" alt="<%= p.name %>">
          <div class="product-info">
            <h3><%= p.name %></h3>
            <div class="price">
              <span class="sale-price"><%= Number(p.sale_price || p.price).toLocaleString('vi-VN') %>đ</span>
            </div>
          </div>
        </a>
      </div>
      <% }) %>
    </div>
  </section>
  <% } %>
</div>

<%- include('../partials/footer') %>
