<%- include('../partials/header') %>

<!-- HERO -->
<section class="hero">
  <div class="container hero-content">
    <h1>Hệ thống camera<br>an ninh chuyên nghiệp</h1>
    <p>Giải pháp giám sát toàn diện cho gia đình và doanh nghiệp</p>
    <a href="/products" class="btn btn-primary btn-lg">Xem sản phẩm</a>
  </div>
</section>

<!-- CATEGORIES -->
<section class="section">
  <div class="container">
    <h2 class="section-title">Danh mục sản phẩm</h2>
    <div class="category-grid">
      <% categories.forEach(cat => { %>
      <a href="/products?category_id=<%= cat.id %>" class="category-card">
        <i class="fas fa-camera"></i>
        <span><%= cat.name %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section class="section bg-light">
  <div class="container">
    <h2 class="section-title">Sản phẩm nổi bật</h2>
    <div class="product-grid">
      <% featuredProducts.forEach(p => { %>
      <div class="product-card">
        <a href="/products/<%= p.slug %>">
          <img src="<%= p.image ? '/uploads/' + p.image : '/images/no-image.jpg' %>" alt="<%= p.name %>">
          <div class="product-info">
            <h3><%= p.name %></h3>
            <p class="category"><%= p.category_name || '' %></p>
            <div class="price">
              <% if (p.sale_price) { %>
                <span class="sale-price"><%= Number(p.sale_price).toLocaleString('vi-VN') %>đ</span>
                <span class="original-price"><%= Number(p.price).toLocaleString('vi-VN') %>đ</span>
              <% } else { %>
                <span class="sale-price"><%= Number(p.price).toLocaleString('vi-VN') %>đ</span>
              <% } %>
            </div>
          </div>
        </a>
        <% if (user) { %>
        <form action="/cart/add" method="POST" class="add-to-cart-form">
          <input type="hidden" name="product_id" value="<%= p.id %>">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="btn btn-primary btn-full">
            <i class="fas fa-cart-plus"></i> Thêm vào giỏ
          </button>
        </form>
        <% } else { %>
        <a href="/auth/login" class="btn btn-outline btn-full">Đăng nhập để mua</a>
        <% } %>
      </div>
      <% }) %>
    </div>
    <div class="text-center mt-4">
      <a href="/products" class="btn btn-outline">Xem tất cả sản phẩm</a>
    </div>
  </div>
</section>

<!-- LATEST NEWS -->
<% if (latestNews.length) { %>
<section class="section">
  <div class="container">
    <h2 class="section-title">Tin tức mới nhất</h2>
    <div class="news-grid">
      <% latestNews.forEach(n => { %>
      <div class="news-card">
        <a href="/news/<%= n.slug %>">
          <% if (n.thumbnail) { %><img src="/uploads/<%= n.thumbnail %>" alt="<%= n.title %>"><% } %>
          <div class="news-info">
            <h3><%= n.title %></h3>
            <p><%= n.excerpt || '' %></p>
            <small><%= new Date(n.created_at).toLocaleDateString('vi-VN') %></small>
          </div>
        </a>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/footer') %>
