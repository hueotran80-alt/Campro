<%- include('../partials/header') %>

<div class="container" style="padding:2rem 0">
  <div class="page-layout">
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <form method="GET" action="/products">
        <div class="filter-group">
          <h4>Tìm kiếm</h4>
          <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Tên sản phẩm..." class="form-control">
        </div>
        <div class="filter-group">
          <h4>Danh mục</h4>
          <select name="category_id" class="form-control">
            <option value="">-- Tất cả --</option>
            <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= query.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group">
          <h4>Khoảng giá</h4>
          <input type="number" name="min_price" value="<%= query.min_price || '' %>" placeholder="Từ (đ)" class="form-control mb-2">
          <input type="number" name="max_price" value="<%= query.max_price || '' %>" placeholder="Đến (đ)" class="form-control">
        </div>
        <div class="filter-group">
          <h4>Sắp xếp</h4>
          <select name="sort" class="form-control">
            <option value="">Mới nhất</option>
            <option value="price_asc"  <%= query.sort === 'price_asc'  ? 'selected' : '' %>>Giá tăng dần</option>
            <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Giá giảm dần</option>
            <option value="popular"    <%= query.sort === 'popular'    ? 'selected' : '' %>>Phổ biến</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Lọc</button>
        <a href="/products" class="btn btn-outline btn-full mt-2">Xóa lọc</a>
      </form>
    </aside>

    <!-- PRODUCTS -->
    <div class="product-main">
      <div class="products-header">
        <h2>Sản phẩm (<%= pagination.total %>)</h2>
      </div>

      <% if (products.length === 0) { %>
        <div class="empty-state"><i class="fas fa-search"></i><p>Không tìm thấy sản phẩm phù hợp.</p></div>
      <% } else { %>
      <div class="product-grid">
        <% products.forEach(p => { %>
        <div class="product-card">
          <a href="/products/<%= p.slug %>">
            <img src="<%= p.image ? '/uploads/' + p.image : '/images/no-image.jpg' %>" alt="<%= p.name %>">
            <div class="product-info">
              <h3><%= p.name %></h3>
              <p class="category"><%= p.category_name || '' %></p>
              <div class="price">
                <% if (p.sale_price) { %>
                  <span class="sale-price"><%= Number(p.sale_price).toLocaleString('vi-VN') %>đ</span>
                  <span class="original-price"><%= Number(p.price).toLocaleString('vi-VN') %>đ</span>
                <% } else { %>
                  <span class="sale-price"><%= Number(p.price).toLocaleString('vi-VN') %>đ</span>
                <% } %>
              </div>
            </div>
          </a>
          <% if (user) { %>
          <form action="/cart/add" method="POST">
            <input type="hidden" name="product_id" value="<%= p.id %>">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="btn btn-primary btn-full">
              <i class="fas fa-cart-plus"></i> Thêm vào giỏ
            </button>
          </form>
          <% } else { %>
          <a href="/auth/login" class="btn btn-outline btn-full">Đăng nhập để mua</a>
          <% } %>
        </div>
        <% }) %>
      </div>

      <!-- PAGINATION -->
      <% if (pagination.totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
          <a href="?<%= new URLSearchParams({...query, page: i}).toString() %>" class="page-btn <%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
        <% } %>
      </div>
      <% } %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
